# 所有环境均强制使用飞书 SSO 登录
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 必须与飞书开放平台登记值完全一致；多个地址用英文逗号分隔
FEISHU_REDIRECT_URIS=http://127.0.0.1:3000/auth/callback

# 会话安全；生产环境请设置独立随机值，使用 HTTPS 时启用安全 Cookie
FY_SESSION_SECRET=
FY_COOKIE_SECURE=false

# 外部人员账号登录；账号记录和密码摘要写入 data/fy_auth.db，不写入源码
FY_LOCAL_AUTH_ENABLED=true
FY_AUTH_DB_PATH=data/fy_auth.db
FY_PERMISSION_STORE=local

# 必填：默认超管的 open_id 或 user_id；多个标识可用英文逗号分隔
FY_SUPER_ADMIN_IDS=

# 旧版 Bitable 字段已弃用，不再作为权限存储配置

# 细节增强上传限制（默认 50MB、单个 ComfyUI 实例超时 30 秒）
DETAIL_ENHANCE_MAX_UPLOAD_BYTES=52428800
DETAIL_ENHANCE_UPLOAD_TIMEOUT=30
