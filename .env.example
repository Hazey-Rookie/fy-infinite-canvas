# 所有环境均强制使用飞书 SSO 登录
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 必须与飞书开放平台登记值完全一致；多个地址用英文逗号分隔
FEISHU_REDIRECT_URIS=http://127.0.0.1:3000/auth/callback

# 会话安全；生产环境请设置独立随机值，使用 HTTPS 时启用安全 Cookie
FY_SESSION_SECRET=
FY_COOKIE_SECURE=false

# 平台超管的 open_id 或 user_id；多租户建议使用 tenant_key:identity，多个标识可用英文逗号分隔
FY_SUPER_ADMIN_IDS=

# 默认租户（单租户兼容模式）
FY_DEFAULT_TENANT_KEY=default
FY_DEFAULT_TENANT_NAME=默认企业

# 多租户配置只写入 API/.env，不得填写真实密钥到此示例文件。
# JSON 数组字段：tenant_key、slug、name、app_id、app_secret、redirect_uris、enabled
FY_TENANTS_JSON=

# 权限数据库路径；生产使用 API/.env 或持久卷路径
FY_AUTH_DB_PATH=data/fy_auth.db
FY_LOCAL_AUTH_ENABLED=true

# 细节增强单文件上限（默认 50MB）
DETAIL_ENHANCE_MAX_UPLOAD_BYTES=52428800
