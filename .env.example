# 所有环境均强制使用飞书 SSO 登录
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 必须与飞书开放平台登记值完全一致；多个地址用英文逗号分隔
FEISHU_REDIRECT_URIS=http://127.0.0.1:8000/auth/callback,http://canvas.example.com:808/auth/callback

# 会话安全；生产环境请设置独立随机值，使用 HTTPS 时启用安全 Cookie
FY_SESSION_SECRET=
FY_COOKIE_SECURE=false

# 必填：默认超管的 open_id 或 user_id；多个标识可用英文逗号分隔
FY_SUPER_ADMIN_IDS=

# 生产环境标识仅写入 API/.env，不得填写到此示例文件
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_MEMBERS_TABLE_ID=
FEISHU_BITABLE_ROLES_TABLE_ID=

# 细节增强上传限制（默认 50MB、单个 ComfyUI 实例超时 30 秒）
DETAIL_ENHANCE_MAX_UPLOAD_BYTES=52428800
DETAIL_ENHANCE_UPLOAD_TIMEOUT=30
